<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- PlateWise home-screen widget: today's ring, flipping cards, + water and snap a meal. -->
        <receiver
            android:name="expo.modules.wearsync.TodayWidget"
            android:exported="false"
            android:label="@string/platewise_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/platewise_widget_info" />
        </receiver>
    </application>
</manifest>
