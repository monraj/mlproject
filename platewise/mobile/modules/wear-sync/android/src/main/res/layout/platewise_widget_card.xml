<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pw_widget_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/pw_card_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/pw_widget_mint_text"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pw_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pw_widget_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pw_card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/pw_widget_muted"
        android:textSize="12sp" />
</LinearLayout>
