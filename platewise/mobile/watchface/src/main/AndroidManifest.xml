<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- A Watch Face Format face has no code: the watch draws res/raw/watchface.xml. -->
    <application
        android:hasCode="false"
        android:icon="@drawable/preview"
        android:label="@string/face_name">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <property android:name="com.google.wear.watchface.format.version" android:value="2" />
        <property android:name="com.google.wear.watchface.format.publisher" android:value="PlateWise" />
    </application>
</manifest>
