# Which AI to use: auto (every provider with a key; gemini → openai → anthropic), gemini, openai, anthropic, or demo.
# With no keys at all the server runs in demo mode and returns sample answers.
VISION_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used when the main model is busy.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Password for the server console at /admin. Leave empty to allow the console only from this computer.
ADMIN_PASSWORD=
# Code the app must send (set it whenever the server is reachable from the internet).
APP_ACCESS_CODE=
AI_REQUESTS_PER_HOUR=120

REQUEST_TIMEOUT_S=60
CORS_ORIGINS=*
